<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="b.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>
    <div class="container">
        <form action="#">
            <h1>Login</h1>

            <div class="input-div">
                <span id="icon"><i class="fa-solid fa-envelope"></i></span>
            <input type="email" name="email" id="email" autocomplete="new-password" required>
            <label for="#" class="input-label"> Email</label>
            </div>

            <div class="input-div">
                <span id="icon"><i class="fa-solid fa-lock"></i></span>
                <input type="password" name="password" id="email"  required>
                <label for="#" class="input-label"> Password</lael>
            </div>

            <div for="#" class="forget-label">
                <label for="#"><input type="checkbox">Remember me</label> <a href="b.html" id="forget">Forget Password?</a>
            </div>

    <button class="login-button">Login</button>

    <div class="or-div">
          <hr><span id="or">OR</span><hr>
    </div>

          <div class="google-div">
            <span id="google-icon"><i class="fa-brands fa-google"></i></span>
           <button class="google-button">Google</button>
          </div>

    <p class="dont">Don't have an account? <a href="#" id="sign">Sign up</a></p>
        </form>
    </div>
    <style>
:root{
    --text_color:  #162938;
    --dark_color: black;
}


* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    height: 100vh;
    width: 100%;
    top: 0;
    left: 0;
    background-image: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    background-size: cover;
    background-position: center;
    display: flex;
    justify-content: center;
    align-items: center;
    background-image:url("https://pg.pngtree.com/thumb_back/fh260/background/20250117/pngtree-hd-photo-editing-background-new-image_16922646.jpg");
}

.container {
    height: 73%;
    width: 24em;
    border: 1px solid black;
    border-radius: 10px;
    padding: 1% 2% 1% 2%;
    backdrop-filter: blur(10px);
    

}



h1 {
    font-size: 36px;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    text-align: center;
    color: #162938;
    margin-bottom: 6%
}

.input-div {
    position:relative;
    height: 50px;
    margin:30px 0;
    width:100%;
    border-bottom: 2px solid black;
}

.input-div input {
    height:100%;
    width:100%;
    border:none;
    background:transparent;
    outline:none;
    font-size: 1em;
    color: var(--text-color);
    font-weight: 600;
    padding: 0 35px 0 5px;
}

#icon{
    position:absolute;
    top:50%;
    right:8px;
    line-height: 57px;
    color:var(--text_color);
    transform:translateY(-50%);
    font-size: 1.2em;
}


.input-div input:focus ~ .input-label,
.input-div input:valid ~ .input-label{
    top: -5px;
}

.input-label {
    position:absolute;
    top:50%;
    left:5px;
    transform:translateY(-50%);
    font-size:1em;
    color: var(--text_color);
    font-weight: 500;
    pointer-events:none;
    transition: .5s;
}


.forget-label {
    font-size: 1em;
    font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
    color: var(--text_color);
    display:flex;
    justify-content:space-between;
}

#forget {
    text-decoration: none;
    color: var(--text_color);
}

.login-button {
    width: 100%;
    height: 3rem;
    background-color: var(--text_color);
    color: white;
    border: none;
    font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
    font-size: 17px;
    border-radius: 50px;
    margin-top: 7%;
    transition: 0.5s ease;
}

.or-div{
    
    display:flex;
    align-items:center;
    justify-content:space-evenly;
}

#or{
    color: var(--dark_color);
    font-size: 17px;
    font-family:'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
    margin: 10px 0;

}

hr{
    height:1px;
    color:var(--dark_color);
    width:40%;
    flex-direction: column;
}

.google-div{
    height: 50px;
    width:100%;
    position:relative;
}

#google-icon{
    position:absolute;
    top:50%;
    left:35%;
    transform:translateY(-50%);
    line-height: 57px;
    background:linear-gradient(red,red,blue);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    -webkit-text-fill-color:transparent;
}

.google-button{
    width:100%;
    height: 100%;
    border:none;
    border-radius: 50px;
    font-size:1em;
    color:white;
    background-color:var(--text_color);
    font-weight: 700;
    transition: 0.5s ease;
}

button:hover{
    background-color:black;
}

.dont {
    color: var(--text_color);
    text-align: center;
    font-size: 17px;
    font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
    margin-top: 4%;
}

#sign {
    color: rgb(48, 48, 48);
    text-decoration: none;
}

#sign:hover,
#forget:hover {
    text-decoration: underline;
}
    </style>
    
</body>
<script src="b.js"></script>

</html>
